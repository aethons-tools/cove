{
  "mcpServers": {
    "messaging": {
      "command": "cove-master",
      "args": ["mcp"],
      "env": {
        "AT_HARBOR_RUNTIME_ADDR": "${AT_HARBOR_RUNTIME_ADDR}",
        "AT_HARBOR_IDENTITY_TOKEN": "${AT_HARBOR_IDENTITY_TOKEN}",
        "http_proxy": "${http_proxy}",
        "https_proxy": "${https_proxy}",
        "HTTP_PROXY": "${HTTP_PROXY}",
        "HTTPS_PROXY": "${HTTPS_PROXY}",
        "no_proxy": "${no_proxy}",
        "NO_PROXY": "${NO_PROXY}"
      }
    }
  }
}
