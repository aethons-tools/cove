[Unit]
# squid — the only permitted egress — as a supervised long-running unit (COV-125).
# COV-118 started squid from the cove-egress oneshot as a backgrounded daemon: the
# daemonizing process wrote /run/squid.pid, forked the coordinator, then exited and
# removed the pid file — so the per-session `squid -k reconfigure`
# (apply-session-domains, COV-39) had no pid file to signal and failed at connect.
# Running squid in the FOREGROUND keeps the coordinator as the main process and the
# pid file live. Ordered after the nftables drop and before every network-capable
# service, so the lock is fully up before sshd / the inner dockerd start.
Description=cove egress proxy (squid) — the only permitted egress; up before any network-capable service
DefaultDependencies=no
After=cove-egress.service
Requires=cove-egress.service
Before=network-pre.target sshd.service ssh.service ssh.socket docker.service docker.socket
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /var/log/squid && chown proxy:proxy /var/log/squid'
ExecStart=/usr/sbin/squid --foreground -f /etc/squid/squid.conf
# --foreground keeps the coordinator as $MAINPID (no daemonizing fork that removes
# the pid file), so /run/squid.pid persists for `squid -k reconfigure`. Pin it to
# the coordinator as belt-and-suspenders in case this squid build skips the pid
# file in foreground mode; the guard never writes an empty/bad pid file.
ExecStartPost=/bin/sh -c '[ -n "$MAINPID" ] && echo "$MAINPID" > /run/squid.pid || true'
ExecReload=/usr/sbin/squid -k reconfigure -f /etc/squid/squid.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
