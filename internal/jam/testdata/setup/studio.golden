== destinations (config)
  anthropic
    route:       /anthropic/
    upstream:    https://api.anthropic.com
    identity-in: x-api-key
    apply:       x-api-key
    credential:  anthropic-key
    git:         no
    allow-paths: any
    env keys:    ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL
  gh
    route:       /gh/
    upstream:    https://api.github.com
    identity-in: bearer
    apply:       custom (header Authorization, template "token {cred}")
    credential:  gh-bot
    git:         routed (https://api.github.com/)
    allow-paths: any
    env keys:    GH_HOST, GH_TOKEN
