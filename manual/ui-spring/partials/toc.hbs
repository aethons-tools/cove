{{!-- Jam (adapted from antora-ui-spring's toc.hbs, MPL-2.0): the theme's page TOC, without its "Edit this Page" / "GitHub Project" / Stack Overflow links. --}}
<aside class="sidebar">
  <div class="content">
    <div
      class="toc"
      data-title="{{{detag page.title}}}"
      data-levels="{{{or page.attributes.toclevels 2}}}"
    >
      <div class="toc-menu"></div>
    </div>
  </div>
</aside>
