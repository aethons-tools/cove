{{!-- Jam (adapted from antora-ui-spring's nav-tree.hbs, MPL-2.0): the theme's nav tree plus a "Team only" badge on internal pages (manual/extensions/internal.js). --}}
{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}" data-depth="{{or ../level 0}}">
    {{#if ./content}}
    {{#if ./items.length}}
    <button class="nav-item-toggle"></button>
    {{/if}}
    {{#if ./url}}
    <a class="nav-link{{#if ./roles}} {{{./roles}}}{{~/if}}" {{#if ./target}} target="{{{./target}}}"{{~/if}} href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">{{{./content}}}</a>{{#if ./internal}} <span class="team-only">Team only</span>{{/if}}
    {{else}}
    <span class="nav-text">{{{./content}}}{{#if ./internal}} <span class="team-only">Team only</span>{{/if}}</span>
    {{/if}}
    {{/if}}
{{> nav-tree navigation=./items level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}
