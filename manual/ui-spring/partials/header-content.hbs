{{!-- Jam (adapted from antora-ui-spring's header-content.hbs, MPL-2.0): the theme's spring.io header replaced: our site title, lunr search with an "In this book" filter, the theme's dark toggle. --}}
<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item jam-brand" href="{{{relativize site.homeUrl}}}">{{{site.title}}}</a>
    </div>
    {{#if env.SITE_SEARCH_PROVIDER}}
    <div id="search-field" class="jam-search">
      <input id="search-input" type="text" placeholder="Search the books" aria-label="Search" autocomplete="off">
      <label class="jam-filter"><input type="checkbox" data-facet-filter="component:{{page.component.name}}"> In this book</label>
    </div>
    {{/if}}
    <label class="theme-toggler">
      <input type="checkbox" id="switch-theme-checkbox" name="switch-theme-checkbox" />
      <span class="icon"><svg aria-hidden="true" class="svg-inline--fa fa-moon moon" viewBox="0 0 384 512"><path fill="currentColor" d="M223.5 32C100 32 0 132.3 0 256S100 480 223.5 480c60.6 0 115.5-24.2 155.8-63.4c5-4.9 6.3-12.5 3.1-18.7s-10.1-9.7-17-8.5c-9.8 1.7-19.8 2.6-30.1 2.6c-96.9 0-175.5-78.8-175.5-176c0-65.8 36-123.1 89.3-153.3c6.1-3.5 9.2-10.5 7.7-17.3s-7.3-11.9-14.3-12.5c-6.3-.5-12.6-.8-19-.8z"></path></svg><svg aria-hidden="true" class="svg-inline--fa fa-sun sun" viewBox="0 0 512 512"><path fill="currentColor" d="M256 160a96 96 0 1 0 0 192 96 96 0 1 0 0-192zM256 0l40 96h-80zM256 512l-40-96h80zM0 256l96-40v80zM512 256l-96 40v-80z"></path></svg></span>
      <span class="text">light</span>
    </label>
  </nav>
</header>
<script>
!function (theme) {
  if (theme === 'dark') document.getElementById('switch-theme-checkbox').parentElement.classList.add('active')
}(localStorage && localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)')?.matches && 'dark'))
</script>
