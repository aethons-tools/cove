<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{{page.title}}} · {{{page.component.title}}}</title>
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
</head>
<body>
<header class="top">
  <a class="brand" href="{{{relativize site.homeUrl}}}">{{{site.title}}}</a>
  {{!-- One book per Antora component (site.components); a lone book shows as a plain label. --}}
  <nav class="books{{#unless (many site.components)}} single{{/unless}}" aria-label="Book">
    {{#each site.components}}
    <a class="{{#if (eq ./name @root.page.component.name)}}on{{/if}}" href="{{{relativize ./url}}}">{{{./title}}}</a>
    {{/each}}
  </nav>
  {{!-- Search: only when @antora/lunr-extension is on (team playbooks; the customer build has none). --}}
  {{#if env.SITE_SEARCH_PROVIDER}}
  <div id="search-field" class="search{{#if (many site.components)}} has-filter{{/if}}">
    <input id="search-input" type="text" placeholder="Search the books" aria-label="Search"{{#if page.home}} autofocus{{/if}}>
    {{#if (many site.components)}}
    <label class="filter"><input type="checkbox" data-facet-filter="component:{{page.component.name}}"> In this book</label>
    {{/if}}
  </div>
  {{/if}}
  {{#if page.versions}}
  <nav class="versions" aria-label="Manual version">
    {{#each page.versions}}
    <a class="{{#if (eq ./version @root.page.version)}}on{{/if}}{{#if ./missing}} missing{{/if}}" href="{{{relativize ./url}}}">{{./displayVersion}}</a>
    {{/each}}
  </nav>
  {{/if}}
</header>
<div class="layout">
  <nav class="side">{{> nav-tree items=page.navigation}}</nav>
  <main class="main">
    {{#if (eq page.version 'next')}}<p class="banner">Merged, not released yet.</p>{{/if}}
    {{#if (eq page.version 'goal')}}<p class="banner">How the product should work, not necessarily how it works today.</p>{{/if}}
    {{!-- article.doc and h1.page: what the search indexer reads (only this, not header, nav or banners). --}}
    <article class="doc">
    <h1 class="page">{{{page.title}}}</h1>
    {{{page.contents}}}
    </article>
  </main>
</div>
{{#if env.SITE_SEARCH_PROVIDER}}
{{> search-scripts}}
{{/if}}
</body>
</html>
