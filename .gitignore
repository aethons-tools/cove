# `go build ./cmd/<name>` output at the repo root
/adopt-base
/jam
/jam-studio-agent
/gen-blessed

# Per-command build outputs in cmd/*/
/cmd/*/jam
/cmd/*/jam-studio-agent

# pre-rename local builds
/at-jam
/at-mint
/cove-master
/cmd/*/at-*
/internal/covemasterbin/

# Stale staged binaries from the removed at-task / at-switchboard
/internal/attask/
/internal/atswitchboard/

# local monitoring secrets
/deploy/monitoring/.local/

# The Jam app bundle, built by `just app` (scripts/app.sh) and embedded by
# jam; only its placeholder is committed.
/internal/jam/uiassets/app/*
/internal/jam/uiassets/app.tmp/
/internal/jam/uiassets/app.old/
!/internal/jam/uiassets/app/.keep
/internal/jam/vscodeext/vsix/*
!/internal/jam/vscodeext/vsix/.keep
/web/app/node_modules/
/web/app/dist/
/web/app/*.tsbuildinfo
/web/vscode/node_modules/
/web/vscode/dist/
# a vitest run rooted in a subdirectory caches there
/web/app/src/node_modules/
