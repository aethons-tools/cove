# Go env for the cove dev loop, exposed to every SSH session (COV-34).
# PATH restates 00-base.env's entries because a later env.d fragment shadows it
# (pam_env is last-wins); the /usr/local/go/bin + go/bin additions are appended.
# TODO: PATH should be composed
GOROOT=/usr/local/go
GOPATH=/home/agent/go
GOPROXY=direct
GOSUMDB=off
GOFLAGS=-mod=mod
PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/go/bin:/home/agent/go/bin
