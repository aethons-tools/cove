# Base-owned session env (COV-34). at-cove's sealed hardening layer concatenates
# /etc/cove/env.d/*.env into /etc/environment so pam_env exposes them to every SSH
# session. This 00- fragment is the foundation; a kit Dockerfile may add higher-
# numbered fragments. Egress is enforced by nftables regardless of these proxy
# vars — they are the convenience that points well-behaved clients at the proxy.
PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
CLAUDE_CONFIG_DIR=/agent-data
http_proxy=http://127.0.0.1:3128
https_proxy=http://127.0.0.1:3128
HTTP_PROXY=http://127.0.0.1:3128
HTTPS_PROXY=http://127.0.0.1:3128
no_proxy=localhost,127.0.0.1,::1,.internal
NO_PROXY=localhost,127.0.0.1,::1,.internal
