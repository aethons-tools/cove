# Credentials file for Jam in the dev container. Copy to
# `dev/local/secrets/credentials.yml` (gitignored; JAM_SECRETS_DIR picks another
# directory); compose mounts that directory read-only at /etc/jam/secrets. DEV ONLY values: the compose Postgres password and
# Garage keys. Never commit real secrets.
#
# The file is mounted read-only and Jam runs as uid 10001: if it is 0600 on the
# host, a Colima mount hides it from that uid and serve exits at startup. Make
# it readable (dev: `chmod 644 dev/local/secrets/credentials.yml`, or chown 10001).
#
# Note: any `command:` resolver you add here runs INSIDE the container (which
# has no docker, ssh, git or gh), not on the host; use `value:` or a command
# over a mounted file (e.g. ["cat", "/run/secrets/x"]).
credentials:
  jam-db:       { value: jam }
  blobs-key:    { value: GKjamdev0000000000000000 }
  blobs-secret: { value: jam-dev-secret-not-secret-0000000000000000 }
  # Studio Manager live test: uncomment with the jam.container.yml entries.
  # anthropic-key: { value: sk-ant-REPLACE_ME }
  # git-pat:       { value: ghp_REPLACE_ME }
