# Template for `at-jam serve` running in the dev container (dev/docker-compose.yml,
# profile "jam"). Copy to `dev/jam.container.yml` (gitignored) and fill in the
# OIDC placeholders; compose mounts it read-only at /etc/jam/jam.yml.
#
#   cp dev/jam.container.yml.example dev/jam.container.yml
#   cp dev/credentials.container.yml.example dev/credentials.container.yml
#
# DEV ONLY: dev Postgres/Garage secrets, a self-signed cert, no production
# hardening. Paths below are INSIDE the container. Jam runs no in-process
# launcher here: remote Studio Managers dial in (runtime.studio-managers).

# Broker + Attach listener. Non-root in the container, so 8443 (compose
# publishes 443:8443). TLS files are mounted at /etc/jam/tls (JAM_TLS_DIR,
# default dev/tls, which `just dev-cert` fills with cert.pem + key.pem). To use a
# Let's Encrypt cert, do NOT point at its live/ dir (relative symlinks into
# ../../archive do not resolve inside the mount). Copy the files, dereferenced,
# into a directory of your own and set JAM_TLS_DIR to its absolute path:
#   cp -L /etc/letsencrypt/live/HOST/fullchain.pem DIR/cert.pem
#   cp -L /etc/letsencrypt/live/HOST/privkey.pem   DIR/key.pem
# Jam runs as uid 10001, so key.pem must be readable by it: privkey.pem (and
# Homebrew OpenSSL's key.pem) are 0600, which a Colima mount hides from that uid.
# Dev: `chmod 644 DIR/key.pem` (or chown 10001).
listen: ":8443"
tls:
  cert: /etc/jam/tls/cert.pem
  key:  /etc/jam/tls/key.pem

ui-hosts:
  - jam.local.aethons.tools

# Admin API on all interfaces inside the container (compose publishes it on the
# host's 127.0.0.1:8081 only). Off-loopback, so serve requires TLS plus
# operator-auth.oidc below. No dev-identity or loopback trust here; for a
# loopback-trusted CLI use `docker compose exec jam at-jam <verb>`.
admin-listen: ":8081"
admin-tls:
  cert: /etc/jam/tls/cert.pem
  key:  /etc/jam/tls/key.pem

# Control-plane store: the compose `postgres` service.
store-postgres:
  host: postgres
  port: 5432
  database: jam
  user: jam
  sslmode: disable
  password-cred: jam-db

# Attachments: the compose `garage` service.
blobs:
  endpoint: http://garage:3900
  bucket: jam-attachments
  region: garage
  path-style: true
  access-key-cred: blobs-key
  secret-key-cred: blobs-secret

# Credential NAMES only; the secrets come from the credentials file.
credentials-file: /etc/jam/credentials.yml
credentials:
  jam-db: {}
  blobs-key: {}
  blobs-secret: {}
  # The Studio Manager live test (docs/usage/jam/studio-manager-live-test.md)
  # needs these destinations' secrets too; uncomment, fill in the matching
  # entries in the credentials file, and restart Jam.
  # anthropic-key: {}
  # git-pat: {}

operator-auth:
  oidc:
    issuer: https://YOUR_TENANT.us.auth0.com/
    audience: https://harbor.aethons.tools/admin
    require-scope: harbor:admin
    device-client-id: "<your-oidc-device-client-id>"
    browser-client-id: "<your-oidc-browser-client-id>"
    device-scope: openid harbor:admin

# Remote Studio Managers dial in; there is no runtime.launcher in the container.
runtime:
  studio-managers: true

# Optional subscription-OAuth pool: see dev/jam.dev.yml.example and
# docs/usage/jam/pool.md (pool.store must be a path inside /var/lib/jam).
