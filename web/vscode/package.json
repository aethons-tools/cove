{
  "name": "jam",
  "displayName": "Jam",
  "description": "Open your Jam sessions' studios in VS Code.",
  "publisher": "aethons",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "repository": { "type": "git", "url": "https://github.com/aethons-tools/cove.git", "directory": "web/vscode" },
  "engines": { "vscode": "^1.105.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onUri"],
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "commands": [
      { "command": "jam.signIn", "title": "Sign In", "category": "Jam" },
      { "command": "jam.signOut", "title": "Sign Out", "category": "Jam" },
      { "command": "jam.openSession", "title": "Open Session…", "category": "Jam" },
      { "command": "jam.forgetHostKey", "title": "Forget Host Key", "category": "Jam" },
      { "command": "jam.focusSession", "title": "Focus Session…", "category": "Jam" },
      { "command": "jam.conversation.pin", "title": "Pin to This Session", "icon": "$(pin)" },
      { "command": "jam.conversation.unpin", "title": "Follow the Window's Session", "icon": "$(pinned)" },
      { "command": "jam.thinking.pin", "title": "Pin to This Session", "icon": "$(pin)" },
      { "command": "jam.thinking.unpin", "title": "Follow the Window's Session", "icon": "$(pinned)" },
      { "command": "jam.previews.pin", "title": "Pin to This Session", "icon": "$(pin)" },
      { "command": "jam.previews.unpin", "title": "Follow the Window's Session", "icon": "$(pinned)" },
      { "command": "jam.status.pin", "title": "Pin to This Session", "icon": "$(pin)" },
      { "command": "jam.status.unpin", "title": "Follow the Window's Session", "icon": "$(pinned)" },
      { "command": "jam.artifacts.pin", "title": "Pin to This Session", "icon": "$(pin)" },
      { "command": "jam.artifacts.unpin", "title": "Follow the Window's Session", "icon": "$(pinned)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "jam", "title": "Jam", "icon": "media/jam.svg" }],
      "panel": [{ "id": "jamPanel", "title": "Jam", "icon": "media/jam.svg" }]
    },
    "views": {
      "jam": [
        { "type": "webview", "id": "jam.conversation", "name": "Conversation" },
        { "type": "webview", "id": "jam.status", "name": "Status" },
        { "type": "webview", "id": "jam.artifacts", "name": "Artifacts", "visibility": "collapsed" },
        { "type": "webview", "id": "jam.previews", "name": "Previews", "visibility": "collapsed" }
      ],
      "jamPanel": [{ "type": "webview", "id": "jam.thinking", "name": "Thinking" }]
    },
    "menus": {
      "view/title": [
        {
          "command": "jam.conversation.pin",
          "when": "view == jam.conversation && jam.conversation.hasSession && !jam.conversation.pinned",
          "group": "navigation"
        },
        { "command": "jam.conversation.unpin", "when": "view == jam.conversation && jam.conversation.pinned", "group": "navigation" },
        {
          "command": "jam.thinking.pin",
          "when": "view == jam.thinking && jam.thinking.hasSession && !jam.thinking.pinned",
          "group": "navigation"
        },
        { "command": "jam.thinking.unpin", "when": "view == jam.thinking && jam.thinking.pinned", "group": "navigation" },
        {
          "command": "jam.previews.pin",
          "when": "view == jam.previews && jam.previews.hasSession && !jam.previews.pinned",
          "group": "navigation"
        },
        { "command": "jam.previews.unpin", "when": "view == jam.previews && jam.previews.pinned", "group": "navigation" },
        {
          "command": "jam.status.pin",
          "when": "view == jam.status && jam.status.hasSession && !jam.status.pinned",
          "group": "navigation"
        },
        { "command": "jam.status.unpin", "when": "view == jam.status && jam.status.pinned", "group": "navigation" },
        {
          "command": "jam.artifacts.pin",
          "when": "view == jam.artifacts && jam.artifacts.hasSession && !jam.artifacts.pinned",
          "group": "navigation"
        },
        { "command": "jam.artifacts.unpin", "when": "view == jam.artifacts && jam.artifacts.pinned", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "jam.conversation.pin", "when": "false" },
        { "command": "jam.conversation.unpin", "when": "false" },
        { "command": "jam.thinking.pin", "when": "false" },
        { "command": "jam.thinking.unpin", "when": "false" },
        { "command": "jam.previews.pin", "when": "false" },
        { "command": "jam.previews.unpin", "when": "false" },
        { "command": "jam.status.pin", "when": "false" },
        { "command": "jam.status.unpin", "when": "false" },
        { "command": "jam.artifacts.pin", "when": "false" },
        { "command": "jam.artifacts.unpin", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Jam",
      "properties": {
        "jam.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Your Jam's address, e.g. `https://jam.example.com` (`https:` only; `http:` for localhost)."
        },
        "jam.cliPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Absolute path to the `jam` CLI; empty searches `PATH`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "package": "npm run build && vsce package --no-dependencies --skip-license -o dist/jam.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
